{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/direction-spec.schema.json",
  "title": "Direction Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "problem_statement",
    "target_users",
    "desired_outcomes",
    "selected_direction",
    "decision_rationale",
    "scope",
    "out_of_scope",
    "constraints",
    "assumptions",
    "risks",
    "open_questions",
    "sources",
    "approval_status"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "project_name": {"type": "string", "minLength": 1},
    "product_name": {"type": "string", "minLength": 1},
    "problem_statement": {"type": "string", "minLength": 20},
    "target_users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": {"type": "string", "pattern": "^USR-[0-9]{3}$"},
              "name": {"type": "string", "minLength": 1},
              "needs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        ]
      }
    },
    "desired_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "selected_direction": {"type": "string", "minLength": 15},
    "decision_rationale": {"type": "string", "minLength": 15},
    "rejected_options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "reason"],
        "properties": {
          "option": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "risk", "impact", "likelihood", "mitigation"],
        "properties": {
          "id": {"type": "string", "pattern": "^RISK-[0-9]{3}$"},
          "risk": {"type": "string", "minLength": 1},
          "impact": {"enum": ["low", "medium", "high"]},
          "likelihood": {"enum": ["low", "medium", "high"]},
          "mitigation": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocking"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q-[0-9]{3}$"},
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "owner": {"type": "string"},
          "due_date": {"type": ["string", "null"], "format": "date"},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "approval_status": {"enum": ["draft", "review", "approved", "rejected"]},
    "decision_date": {"type": ["string", "null"], "format": "date"},
    "decision_owner": {"type": "string"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "status", "authority", "confidence"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "status": {"enum": ["approved", "draft", "reference", "inferred"]},
        "authority": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "source_uri": {"type": ["string", "null"]},
        "meeting_date": {"type": ["string", "null"], "format": "date"},
        "evidence_location": {"type": ["string", "null"]}
      }
    }
  }
}
